# agent-platform 运行时配置（复制为 .env 后按环境修改）

AP_ENV=dev
AP_HTTP_PORT=8900

# 中台 MySQL（复用现有实例，中台独立 schema；库名由 ops 提供）
AP_DB_DSN=mysql+pymysql://user:password@mysql.kd.com:13306/agent_platform?charset=utf8mb4

# Redis（复用现有实例）
AP_REDIS_URL=redis://:password@test.kd.com:16379/12

# 实例/租户默认
AP_DEFAULT_TENANT=changzhou

# 大模型清单（OpenAI 兼容）：{"<key>": {"label": "说明", "base_url": "...", "api_key": "...", "model": "..."}}
# 任意 OpenAI 兼容端点都可接入，例如：
#   {"deepseek": {"label": "DeepSeek", "base_url": "https://api.deepseek.com/v1", "api_key": "sk-...", "model": "deepseek-chat"}}
# 真实密钥请写在 .env（被 .gitignore 忽略），不要提交进本模板文件
AP_LLM_MODELS={}

# 图 DSL 导入：单文件字节上限
AP_UPLOAD_MAX_BYTES=5242880

# 知识库文档：单文件字节上限（默认 15MB）、分块字符数、相邻分块重叠字符数
# 支持 .txt/.md/.markdown/.mdx/.csv/.html/.htm/.pdf/.docx/.xlsx/.xls
AP_DOCUMENT_MAX_BYTES=15728640
AP_DOCUMENT_CHUNK_CHARS=800
AP_DOCUMENT_CHUNK_OVERLAP=0
# 超过该字节数的上传走异步入库（Redis 可用入 worker 队列，否则进程内后台任务）；0 = 全部异步
AP_KNOWLEDGE_ASYNC_THRESHOLD_BYTES=1048576

# 工具调用治理：参数校验 / 瞬时错误重试 / 失败兜底（兜底默认关，工具级可覆盖）
AP_TOOL_VALIDATE=true
AP_TOOL_RETRY_ATTEMPTS=2
AP_TOOL_RETRY_BACKOFF=0.5
AP_TOOL_FALLBACK_ENABLED=false

# 智能体：ReAct / Plan 等模式的默认步数上限
AP_AGENT_MAX_STEPS=6
# 智能体自主循环（autonomous 模式）：单个工具结果回灌模型时的最大字符数
AP_AGENT_TOOL_RESULT_MAX_CHARS=4000

# 代码节点沙箱：inprocess 为受限 exec（默认，兼容旧行为）；docker 为隔离容器（推荐生产）
# docker 模式需本机可执行 docker，容器内禁用网络、只读根、非 root，并限制 CPU/内存/PID/超时
AP_CODE_SANDBOX_MODE=inprocess
AP_CODE_SANDBOX_IMAGE=python:3.11-slim
AP_CODE_SANDBOX_TIMEOUT_SECONDS=5
AP_CODE_SANDBOX_MEMORY=128m
AP_CODE_SANDBOX_CPUS=0.5
AP_CODE_SANDBOX_PIDS_LIMIT=64
# 输出上限（字节）；逗号分隔的镜像白名单，留空不限制镜像
AP_CODE_SANDBOX_MAX_OUTPUT_BYTES=65536
AP_CODE_SANDBOX_ALLOWED_IMAGES=

# 不可信内容隔离（默认关闭）：对工具/知识/子 Agent 输出剥离常见指令注入并加 <untrusted_data> 边界
AP_PROMPT_GUARD_ENABLED=false
AP_PROMPT_GUARD_MAX_CHARS=12000

# HITL 外部通知：中断时向 Webhook POST {event,payload}；留空关闭。失败只记日志，不阻断审批链路
AP_HITL_WEBHOOK_URL=
AP_HITL_WEBHOOK_SECRET=
AP_HITL_WEBHOOK_TIMEOUT_SECONDS=3
AP_HITL_WEBHOOK_ATTEMPTS=2
AP_HITL_WEBHOOK_BACKOFF_SECONDS=0.2
# 外部审批一键链接：配置 secret 后，Webhook payload 会带 HMAC 签名 token；base_url 用于拼绝对地址
AP_HITL_CALLBACK_BASE_URL=
AP_HITL_ACTION_TTL_SECONDS=86400

# 浏览器操作（默认关闭；需 pip install playwright && playwright install chromium）
# Agent 定义里 browser=true 且总闸开启时，才给该 Agent 装配 browser_* 工具
AP_BROWSER_ENABLED=false
AP_BROWSER_HEADLESS=true
AP_BROWSER_TIMEOUT_MS=15000
AP_BROWSER_MAX_CHARS=4000
# 逗号分隔的 host 白名单；留空表示允许公网 http/https，但仍拦截 localhost/私网/链路本地 IP
AP_BROWSER_ALLOWED_HOSTS=
AP_BROWSER_ALLOW_PRIVATE=false
AP_BROWSER_SCREENSHOT_DIR=.run/browser
AP_BROWSER_DOWNLOAD_DIR=.run/downloads
# 允许上传给页面的文件目录；留空则禁用 browser_upload
AP_BROWSER_UPLOAD_DIR=
# 登录态文件（Playwright storage_state）；留空不持久化，包含 cookie/localStorage，请限制文件权限
AP_BROWSER_STORAGE_STATE=

# MCP 工具运行时发现（默认关闭；关闭时只用 ap_tool 声明）
# 开启后，ToolRef.discover=true 的引用才会请求对应 MCP Server 的 tools/list
AP_TOOL_DISCOVERY_ENABLED=false
AP_TOOL_DISCOVERY_TTL_SECONDS=300
AP_TOOL_DISCOVERY_MAX_TOOLS=50

# 模型调用：超时秒数 0 表示沿用 endpoint 默认；重试次数与 ChatOpenAI 默认一致
AP_LLM_TIMEOUT_SECONDS=0
AP_LLM_MAX_RETRIES=2

# checkpointer / 人在环（默认关闭；HITL 只在管理端图运行链路暴露）
AP_CHECKPOINTER_ENABLED=false
AP_HITL_ENABLED=false
# 等待审批超过该秒数标记 expired；0 = 不自动过期
AP_HITL_RUN_TIMEOUT_SECONDS=0

# 动态子图（默认关闭；关闭时含 subgraph 节点的图发布/运行会报错）
AP_SUBGRAPH_ENABLED=false
AP_SUBGRAPH_MAX_DEPTH=2

# 用户级长期记忆（默认关闭；关闭时不查不写、不注入图输入）
AP_USER_MEMORY_ENABLED=false
AP_USER_MEMORY_WRITE_ENABLED=false
AP_USER_MEMORY_RECALL_ENABLED=false
AP_USER_MEMORY_EXTRACT_ASYNC=true
AP_USER_MEMORY_PROVIDER=
AP_USER_MEMORY_MAX_CHARS=4000
AP_USER_MEMORY_TOP_K=5
AP_USER_MEMORY_SCORE_THRESHOLD=
AP_USER_MEMORY_MODE=vector
AP_USER_MEMORY_SCOPE=app
AP_USER_MEMORY_MAX_PER_USER=200
AP_USER_MEMORY_TTL_DAYS=0
AP_USER_MEMORY_DEDUP_THRESHOLD=0.92
AP_USER_MEMORY_INJECT_VAR=user_memory_text

# Agent 应用（自主 agent，原生 function-calling）
# 总闸：默认关闭，关闭时 app_type=agent 的应用仍按工作流图执行（与改造前一致）
AP_AGENT_APP_ENABLED=false
# 单次对话内 agent 循环的步数上限（工具调用轮次兜底）
AP_AGENT_APP_MAX_STEPS=6
# 子 agent 委派递归深度上限
AP_AGENT_APP_DEPTH=2

# 检索流水线（默认关闭：关闭时与只用向量检索逐字节一致）
# 粗召回（向量）候选数，0 表示用知识节点自己的 top_k
AP_RETRIEVAL_COARSE_TOP_K=0
# 精召回：混合检索（向量 + 关键词，RRF 融合）
AP_RETRIEVAL_HYBRID_ENABLED=false
AP_RETRIEVAL_LEXICAL_TOP_K=10
AP_RETRIEVAL_RRF_K=60
# 重排序：开启后对候选调 {base_url}/rerank（body {model, query, documents, top_n}）
AP_RERANK_ENABLED=false
AP_RERANK_BASE_URL=
AP_RERANK_API_KEY=
AP_RERANK_MODEL=
AP_RERANK_TOP_K=0

# 内置向量库
AP_EMBEDDING_DIM=256
AP_EMBEDDING_BASE_URL=
AP_EMBEDDING_API_KEY=
AP_EMBEDDING_MODEL=

# 外接知识平台（M1 可留空）
AP_LIGHT_RAG_BASE_URL=
AP_LIGHT_RAG_API_KEY=
AP_KNOWFLOW_BASE_URL=
AP_KNOWLEDGE_GRAPH_BASE_URL=

# 工具服务注册表：{"name":{"url":"...","kind":"mcp|http","headers":{},"timeout":30}}
AP_TOOL_SERVERS={}

# 兼容层鉴权（云智 client_credentials 换 JWT + Api-Key）
AP_OAUTH_CLIENTS={}
AP_JWT_SECRET=

# 护栏（先上不启用：AP_GUARD_ENABLED=false 时全部短路）
AP_GUARD_ENABLED=false
AP_GUARD_SENSITIVE_ENABLED=false
AP_GUARD_QUOTA_ENABLED=false
AP_GUARD_RATE_ENABLED=false
AP_GUARD_ROUND_ENABLED=false
AP_GUARD_DAILY_TOKEN_QUOTA=0
AP_GUARD_RATE_PER_MINUTE=0
AP_GUARD_MAX_ROUNDS=0
AP_GUARD_DEFAULT_REPLY=

# 记忆：历史消息窗口条数（0 关闭；开启后以 history 变量注入图输入）
AP_HISTORY_WINDOW=0

# 记忆摘要（依赖窗口开启）：窗口之外的历史压缩为 summary 变量注入；生成失败降级为仅窗口
AP_HISTORY_SUMMARY_ENABLED=false
# 摘要使用哪个模型（AP_LLM_MODELS 的 key）；留空用清单第一个
AP_HISTORY_SUMMARY_PROVIDER=
AP_HISTORY_SUMMARY_MAX_CHARS=4000

# 幂等 / 并发（均默认关闭：TTL<=0 关闭幂等；上限<=0 关闭并发限制）
# 幂等仅在调用方显式传 Idempotency-Key 头或 body idempotency_key 时生效；
# 置 true 后以 app+user+conversation+query 自行推导（同会话重复提问会被判为重放）。
AP_IDEMPOTENCY_TTL_SECONDS=600
AP_IDEMPOTENCY_DERIVE_KEY=false
AP_MAX_CONCURRENCY_PER_APP=0
# 并发满时排队等待秒数，0 表示立即拒绝
AP_CONCURRENCY_WAIT_SECONDS=0

# 中台独立账号体系（默认关闭：/admin 免鉴权，行为与改造前一致）
# 置 true 后启动时播种内置角色与种子管理员，/admin 需 Authorization: Bearer <token>
AP_ADMIN_AUTH_ENABLED=false
AP_ADMIN_SEED_USERNAME=admin
AP_ADMIN_SEED_PASSWORD=admin123
AP_ADMIN_TOKEN_TTL_SECONDS=7200

# 本地一体化部署（docker compose）：内置 MySQL / Redis，api/worker 的 AP_DB_DSN / AP_REDIS_URL 在 compose 内覆盖为本地服务
# 不用 compose 内置库时，把上面的 AP_DB_DSN / AP_REDIS_URL 改为内网实例即可
LOCAL_MYSQL_ROOT_PASSWORD=root
LOCAL_MYSQL_PASSWORD=agent
LOCAL_MYSQL_PORT=3306
LOCAL_REDIS_PORT=6379

# Langfuse（M3）：docker compose 内由 langfuse 服务启动时以下列密钥初始化项目，API/worker 经 http://langfuse:3000 上报
AP_LANGFUSE_HOST=
AP_LANGFUSE_PUBLIC_KEY=
AP_LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_DB_PASSWORD=langfuse

# 字段级加密（复用现有 SM4 密钥/IV，与现有库兼容）
AP_SM4_KEY=
AP_SM4_IV=
